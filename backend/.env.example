# Server Configuration
PORT=8080

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campus_mart?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://campus_user:yourPassword@cluster0.mongodb.net/campus_mart?retryWrites=true&w=majority

# Cloudinary Credentials (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Secret (minimum 256 bits / 32 characters)
JWT_SECRET=campusMartSuperSecureSecretKeyForSigningJwtTokensMinimum256BitsLengthRequired
JWT_EXPIRATION_MS=604800000
